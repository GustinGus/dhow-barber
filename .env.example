# Copy to .env.local (ignored by Git) and fill in only when testing against Supabase.
# Only public values belong here: the project URL and the anon/publishable key.
# Never put the service_role key, database password or admin password in a VITE_ variable.

# "local" (default) or "supabase". "supabase" only takes effect when URL and key are also set.
VITE_DATA_SOURCE=local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
